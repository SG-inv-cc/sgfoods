
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SG Munchizz | Food Palace</title>
<meta name="description" content="SG Munchizz Food Palace - fresh, tasty and affordable food in Windhoek.">
<style>
:root{
  --yellow:#ffd21a; --yellow2:#ffb900; --black:#050505; --panel:#0d0d0d;
  --white:#fff; --muted:#c9c9c9; --line:#343434; --green:#25d366;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,Helvetica,sans-serif;background:#050505;color:#fff;line-height:1.45}
button,input,select{font:inherit}
a{color:inherit;text-decoration:none}
.container{width:min(1120px,92%);margin:auto}
header{position:sticky;top:0;z-index:100;background:rgba(4,4,4,.96);backdrop-filter:blur(12px);border-bottom:2px solid var(--yellow)}
.nav{height:72px;display:flex;align-items:center;justify-content:space-between;gap:20px}
.brand{font-weight:1000;font-size:25px;color:var(--yellow);letter-spacing:-1.5px;white-space:nowrap;text-shadow:2px 2px 0 #000}
.brand span{display:block;color:#fff;font-size:8px;letter-spacing:3px;text-align:center;margin-top:-3px}
nav ul{display:flex;gap:30px;list-style:none;font-size:14px}
nav a{transition:.2s}
nav a:hover,nav a.active{color:var(--yellow)}
.actions{display:flex;align-items:center;gap:10px}
.order-btn,.cart-btn{border:0;border-radius:25px;background:var(--yellow);color:#050505;font-weight:900;padding:11px 17px;cursor:pointer}
.cart-btn{position:relative;font-size:20px;padding:8px 12px}
.cart-count{position:absolute;right:-5px;top:-7px;background:#fff;color:#000;border-radius:50%;min-width:20px;height:20px;font-size:11px;display:grid;place-items:center;font-weight:900}
.menu-toggle{display:none;background:none;color:#fff;border:1px solid #555;border-radius:8px;padding:8px}
.hero{min-height:365px;background-image:linear-gradient(90deg,rgba(0,0,0,.68),rgba(0,0,0,.18)),url("data:image/jpeg;base64,");background-size:cover;background-position:center;display:flex;align-items:center;border-bottom:2px solid var(--yellow)}
.hero-content{padding:40px 0;max-width:560px}
.kicker{color:var(--yellow);font-weight:900;letter-spacing:3px}
.hero h1{font-size:clamp(42px,7vw,78px);line-height:.88;text-transform:uppercase;text-shadow:4px 4px 0 #000;margin:12px 0}
.hero h1 span{color:var(--yellow)}
.hero p{font-size:20px;font-weight:800;margin-bottom:20px}
.cta{display:inline-block;background:var(--yellow);color:#000;font-weight:900;padding:13px 22px;border-radius:28px}
section{padding:44px 0}
.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:22px}
.section-head h2{font-size:30px;text-transform:uppercase}
.section-head h2 span{color:var(--yellow)}
.subtitle{color:#aaa;font-size:14px}
.filters{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:22px}
.filter{background:#111;border:1px solid #444;color:#fff;padding:9px 14px;border-radius:20px;cursor:pointer}
.filter.active,.filter:hover{background:var(--yellow);color:#000;border-color:var(--yellow);font-weight:800}
.grid{display:grid;grid-template-columns:repeat(5,1fr);gap:12px}
.card{background:linear-gradient(145deg,#121212,#070707);border:1px solid #454545;border-radius:9px;overflow:hidden;transition:.25s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-5px);border-color:var(--yellow);box-shadow:0 10px 25px rgba(255,210,26,.12)}
.card-img{height:125px;overflow:hidden;background:#111}
.card-img img{width:100%;height:100%;object-fit:cover;display:block}
.card-body{padding:12px;text-align:center;display:flex;flex-direction:column;flex:1}
.card h3{font-size:14px;min-height:38px;display:grid;place-items:center}
.price{color:var(--yellow);font-weight:900;margin:3px 0 10px}
.view-btn{margin-top:auto;border:0;background:var(--yellow);color:#000;border-radius:20px;padding:8px 10px;font-weight:900;cursor:pointer}
.about{display:grid;grid-template-columns:1.2fr .8fr;gap:18px}
.panel{background:#0b0b0b;border:1px solid #3a3a3a;border-radius:12px;padding:25px}
.panel h2{font-size:27px;margin-bottom:10px}
.panel h2 span{color:var(--yellow)}
.panel p{color:#d2d2d2;margin:9px 0}
.highlight{color:var(--yellow);font-weight:900}
.info-list{display:grid;gap:14px;margin-top:12px}
.info{border-bottom:1px solid #333;padding-bottom:13px}
.info b{color:var(--yellow);display:block;margin-bottom:3px}
.contact-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}
.contact-card{padding:20px;background:#0b0b0b;border:1px solid #333;border-radius:12px}
.contact-card .icon{font-size:25px;color:var(--yellow)}
.contact-card h3{margin:7px 0}
.contact-card p{color:#bbb}
footer{border-top:2px solid var(--yellow);padding:25px 0;text-align:center;color:#aaa}
footer strong{color:var(--yellow)}
.modal{position:fixed;inset:0;background:rgba(0,0,0,.8);z-index:200;display:none;align-items:center;justify-content:center;padding:20px}
.modal.show{display:flex}
.modal-box{background:#101010;border:1px solid #555;border-top:4px solid var(--yellow);border-radius:15px;width:min(520px,100%);padding:25px;position:relative}
.close{position:absolute;right:15px;top:10px;background:none;border:0;color:#fff;font-size:28px;cursor:pointer}
.modal h2{color:var(--yellow);margin-bottom:15px}
.cart-item{display:flex;justify-content:space-between;gap:10px;padding:10px 0;border-bottom:1px solid #333}
.total{display:flex;justify-content:space-between;font-size:20px;font-weight:900;margin:18px 0}
.whatsapp{display:block;background:var(--green);color:#001a08;text-align:center;font-weight:900;padding:13px;border-radius:10px}
.empty{color:#999;text-align:center;padding:20px}
@media(max-width:900px){.grid{grid-template-columns:repeat(3,1fr)}.about{grid-template-columns:1fr}nav ul{gap:14px}}
@media(max-width:680px){
  .nav{height:64px}.menu-toggle{display:block}nav{position:absolute;top:64px;left:0;right:0;background:#070707;border-bottom:1px solid #333;display:none}nav.open{display:block}nav ul{padding:15px;flex-direction:column;gap:15px}
  .brand{font-size:20px}.order-btn{display:none}.hero{min-height:390px;background-position:58% center}.hero-content{padding-top:120px}
  .grid{grid-template-columns:repeat(2,1fr)}.card-img{height:110px}.contact-grid{grid-template-columns:1fr}.section-head{display:block}
}
</style>
</head>
<body>
<header>
  <div class="container nav">
    <a class="brand" href="#home">SG MUNCHIZZ<span>FOOD PALACE</span></a>
    <button class="menu-toggle" onclick="toggleNav()">☰</button>
    <nav id="nav"><ul>
      <li><a class="active" href="#home">Home</a></li>
      <li><a href="#menu">Menu</a></li>
      <li><a href="#about">About Us</a></li>
      <li><a href="#gallery">Gallery</a></li>
      <li><a href="#order">Order</a></li>
      <li><a href="#contact">Contact</a></li>
    </ul></nav>
    <div class="actions">
      <button class="order-btn" onclick="document.querySelector('#menu').scrollIntoView()">☏ Order Now</button>
      <button class="cart-btn" onclick="openCart()">🛒<span class="cart-count" id="count">0</span></button>
    </div>
  </div>
</header>

<main>
<section class="hero" id="home">
  <div class="container hero-content">
    <div class="kicker">FRESH • TASTY • AFFORDABLE</div>
    <h1><span>SG</span><br>Munchizz</h1>
    <p>Half the price, <span style="color:var(--yellow)">twice the chizz.</span></p>
    <a class="cta" href="#menu">Explore Our Menu ↓</a>
  </div>
</section>

<section id="menu">
  <div class="container">
    <div class="section-head">
      <div><h2>Our <span>Menu</span></h2><div class="subtitle">Real ingredients • Tasty flavours • Great vibes</div></div>
      <div class="highlight">Small prices. Big flavour.</div>
    </div>
    <div class="filters">
      <button class="filter active" onclick="filterCards('all',this)">All</button>
      <button class="filter" onclick="filterCards('Meals',this)">Meals</button>
      <button class="filter" onclick="filterCards('Rolls',this)">Rolls</button>
      <button class="filter" onclick="filterCards('Snacks',this)">Snacks</button>
      <button class="filter" onclick="filterCards('Sweets',this)">Sweets</button>
      <button class="filter" onclick="filterCards('Drinks',this)">Drinks</button>
    </div>
    <div class="grid"><article class="card" data-cat="Rolls">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="SG Falfil Roll"></div>
      <div class="card-body">
        <h3>SG Falfil Roll</h3>
        <p class="price">N$7 – N$55</p>
        <button class="view-btn" onclick="addToCart('SG Falfil Roll','N$7 – N$55')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Meals">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="SG Hot Dog"></div>
      <div class="card-body">
        <h3>SG Hot Dog</h3>
        <p class="price">N$15 – N$30</p>
        <button class="view-btn" onclick="addToCart('SG Hot Dog','N$15 – N$30')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Meals">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="SG Getsbee"></div>
      <div class="card-body">
        <h3>SG Getsbee</h3>
        <p class="price">N$45 – N$80</p>
        <button class="view-btn" onclick="addToCart('SG Getsbee','N$45 – N$80')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Sweets">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Jelly Cups"></div>
      <div class="card-body">
        <h3>Jelly Cups</h3>
        <p class="price">N$7 – N$15</p>
        <button class="view-btn" onclick="addToCart('Jelly Cups','N$7 – N$15')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Sweets">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Cupcakes"></div>
      <div class="card-body">
        <h3>Cupcakes</h3>
        <p class="price">N$7 – N$15</p>
        <button class="view-btn" onclick="addToCart('Cupcakes','N$7 – N$15')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Sweets">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Sweets"></div>
      <div class="card-body">
        <h3>Sweets</h3>
        <p class="price">From N$1</p>
        <button class="view-btn" onclick="addToCart('Sweets','From N$1')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Snacks">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Stockies"></div>
      <div class="card-body">
        <h3>Stockies</h3>
        <p class="price">N$2</p>
        <button class="view-btn" onclick="addToCart('Stockies','N$2')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Snacks">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Biscuits"></div>
      <div class="card-body">
        <h3>Biscuits</h3>
        <p class="price">N$1 – N$20</p>
        <button class="view-btn" onclick="addToCart('Biscuits','N$1 – N$20')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Drinks">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Soft &amp; Juicy Drinks"></div>
      <div class="card-body">
        <h3>Soft &amp; Juicy Drinks</h3>
        <p class="price">From N$10</p>
        <button class="view-btn" onclick="addToCart('Soft &amp; Juicy Drinks','From N$10')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Sweets">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="SG Chilly Fireball"></div>
      <div class="card-body">
        <h3>SG Chilly Fireball</h3>
        <p class="price">N$2 – N$10</p>
        <button class="view-btn" onclick="addToCart('SG Chilly Fireball','N$2 – N$10')">Add to order</button>
      </div>
    </article>
<article class="card" data-cat="Sweets">
      <div class="card-img"><img src="data:image/jpeg;base64," alt="Coloured Sweet Rings / Balls / Tear"></div>
      <div class="card-body">
        <h3>Coloured Sweet Rings / Balls / Tear</h3>
        <p class="price">N$2 – N$10</p>
        <button class="view-btn" onclick="addToCart('Coloured Sweet Rings / Balls / Tear','N$2 – N$10')">Add to order</button>
      </div>
    </article></div>
  </div>
</section>

<section id="about">
  <div class="container about">
    <div class="panel">
      <h2>About <span>SG Munchizz</span></h2>
      <p>Customized tasty munchizz with flavours inspired by Namibia. We make food that feels familiar, filling and full of character.</p>
      <p>From loaded rolls and hot dogs to pizza, sweets and drinks, our menu is built around <span class="highlight">real food, real flavour and good vibes.</span></p>
      <p class="highlight">Same good food. Different day. 👑</p>
    </div>
    <div class="panel">
      <h2>Quick <span>Info</span></h2>
      <div class="info-list">
        <div class="info"><b>🕐 OPENING HOURS</b>13:00 – 17:00<br>Pickup: Outside WVTC Main Gate<br>Deliveries: until 19:00</div>
        <div class="info"><b>🛵 DELIVERY</b>Yango Delivery. Delivery fee can be split among buyers or added to the bill.</div>
        <div class="info"><b>☏ ORDER NOW</b>081 264 3563<br><small>WhatsApp orders</small></div>
      </div>
    </div>
  </div>
</section>

<section id="gallery">
  <div class="container">
    <div class="section-head"><div><h2>Food <span>Gallery</span></h2><div class="subtitle">A taste of what is cooking.</div></div></div>
    <div class="grid">
      <div class="card"><div class="card-img"><img src="data:image/jpeg;base64," alt="SG Munchizz food"></div><div class="card-body"><h3>Signature Spread</h3></div></div>
      <div class="card"><div class="card-img"><img src="data:image/jpeg;base64," alt="Loaded roll"></div><div class="card-body"><h3>Loaded Rolls</h3></div></div>
      <div class="card"><div class="card-img"><img src="data:image/jpeg;base64," alt="Pizza"></div><div class="card-body"><h3>SG Pizza</h3></div></div>
      <div class="card"><div class="card-img"><img src="data:image/jpeg;base64," alt="Hot dog"></div><div class="card-body"><h3>SG Hot Dog</h3></div></div>
      <div class="card"><div class="card-img"><img src="data:image/jpeg;base64," alt="Sweets"></div><div class="card-body"><h3>Sweet Treats</h3></div></div>
    </div>
  </div>
</section>

<section id="order">
  <div class="container panel">
    <div class="section-head">
      <div><h2>Ready to <span>Order?</span></h2><div class="subtitle">Add items to your basket, then send your order on WhatsApp.</div></div>
      <button class="order-btn" onclick="openCart()">View Basket 🛒</button>
    </div>
    <p>Pickup: <b>Outside WVTC Main Gate, Windhoek</b> • Delivery: <b>Yango</b> • Payment: <b>Cash | Yango Pay | Bank Transfer</b></p>
  </div>
</section>

<section id="contact">
  <div class="container">
    <div class="section-head"><div><h2>Find <span>Us</span></h2><div class="subtitle">Come through, order up and enjoy.</div></div></div>
    <div class="contact-grid">
      <div class="contact-card"><div class="icon">📍</div><h3>Location</h3><p>Outside WVTC Main Gate<br>Windhoek, Namibia</p></div>
      <div class="contact-card"><div class="icon">📱</div><h3>WhatsApp</h3><p>081 264 3563<br>Orders & enquiries</p></div>
      <div class="contact-card"><div class="icon">📸</div><h3>Follow Us</h3><p>@small_giant_2026<br>Instagram • TikTok • Facebook</p></div>
    </div>
  </div>
</section>
</main>

<footer>
  <div class="container"><strong>SG MUNCHIZZ</strong> • FOOD PALACE<br><span>HALF THE PRICE, TWICE THE CHIZZ</span></div>
</footer>

<div class="modal" id="cartModal" onclick="if(event.target===this)closeCart()">
  <div class="modal-box">
    <button class="close" onclick="closeCart()">×</button>
    <h2>Your Basket 🛒</h2>
    <div id="cartItems"></div>
    <div class="total"><span>Items</span><span id="totalItems">0</span></div>
    <a id="waLink" class="whatsapp" href="#" target="_blank">Send Order on WhatsApp</a>
  </div>
</div>

<script>
let cart=[];
function toggleNav(){document.getElementById('nav').classList.toggle('open')}
document.querySelectorAll('nav a').forEach(a=>a.addEventListener('click',()=>document.getElementById('nav').classList.remove('open')));
function filterCards(cat,btn){
  document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active')); btn.classList.add('active');
  document.querySelectorAll('.card[data-cat]').forEach(c=>c.style.display=(cat==='all'||c.dataset.cat===cat)?'flex':'none');
}
function addToCart(name,price){
  cart.push({name,price}); updateCart(); openCart();
}
function updateCart(){
  document.getElementById('count').textContent=cart.length;
  document.getElementById('totalItems').textContent=cart.length;
  const box=document.getElementById('cartItems');
  if(!cart.length){box.innerHTML='<div class="empty">Your basket is empty. Add something tasty.</div>';}
  else {
    box.innerHTML=cart.map((x,i)=>`<div class="cart-item"><span>${i+1}. ${x.name}</span><b>${x.price}</b></div>`).join('');
  }
  const message='Hello SG Munchizz! I would like to order:%0A%0A'+cart.map((x,i)=>`${i+1}. ${x.name} - ${x.price}`).join('%0A')+'%0A%0APlease confirm my order.';
  document.getElementById('waLink').href='https://wa.me/264812643563?text='+message;
}
function openCart(){document.getElementById('cartModal').classList.add('show');updateCart()}
function closeCart(){document.getElementById('cartModal').classList.remove('show')}
updateCart();
</script>
</body>
</html>
